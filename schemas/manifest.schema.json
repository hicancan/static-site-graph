{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "site_id",
    "generated_at",
    "totals",
    "outcomes"
  ],
  "properties": {
    "site_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "totals": {
      "type": "object"
    },
    "outcomes": {
      "type": "object"
    },
    "errors": {
      "type": "array"
    },
    "quality": {
      "type": "object"
    },
    "coverage_status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "incremental"
      ]
    },
    "audit_evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "pagination_terminal_verified": {
      "type": "boolean"
    },
    "unknown_url_count": {
      "type": "integer",
      "minimum": 0
    },
    "excluded_url_count": {
      "type": "integer",
      "minimum": 0
    },
    "coverage": {
      "type": "object"
    }
  }
}
