{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m sitegraph.cli *)",
      "Bash(pytest *)",
      "Bash(python -m pip install -e .*)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "WebFetch(domain:jwc.njupt.edu.cn)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./data/**/raw/html/**)"
    ],
    "additionalDirectories": []
  }
}
