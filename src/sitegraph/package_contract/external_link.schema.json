{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:static-site-graph:site-package:external-link",
  "type": "object",
  "required": [
    "external_id",
    "url",
    "label",
    "source_url",
    "source_section_id",
    "category",
    "recorded_at"
  ],
  "properties": {
    "external_id": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_section_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "redirect_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "redirect_status_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "source_redirect_url": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
